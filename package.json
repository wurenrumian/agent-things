{
  "name": "agent-things",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @agent/server run dev",
    "dev:web": "pnpm --filter @agent/web run dev",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "packageManager": "pnpm@10.30.1"
}
