{
  "name": "agent-things",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @agent/server run dev",
    "dev:web": "pnpm --filter @agent/web run dev",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "pnpm -r run typecheck",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress preview docs --port 4174",
    "docs:preview": "vitepress preview docs --port 4174"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.30.1"
}
