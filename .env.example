# Copy to .env and fill in.
OPENROUTER_API_KEY=sk-or-...

# Model to drive the agent. Any OpenRouter model id.
# Anthropic models support explicit prompt cache breakpoints.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional OpenRouter attribution headers.
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=agent-things

# Server
PORT=8787
DATA_DIR=./data

# Permission mode for M0: yolo | standard | readonly
PERMISSION_MODE=yolo
